# Stellar Network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract IDs (populated by deploy-contracts.sh)
NEXT_PUBLIC_LAND_CONTRACT_ID=
NEXT_PUBLIC_ASSET_CONTRACT_ID=
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ID=
NEXT_PUBLIC_SVRS_TOKEN_CONTRACT_ID=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellarverse

# IPFS / Pinata
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Arweave
ARWEAVE_KEY_FILE=./arweave-key.json

# Indexer
INDEXER_PORT=3001
FRONTEND_URL=http://localhost:3000
STELLAR_CURSOR=now

# Auth
JWT_SECRET=change-me-in-production
