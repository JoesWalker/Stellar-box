{
  "name": "@stellarverse/stellar-client",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.0.0",
    "@stellarverse/types": "*",
    "arweave": "1.15.0",
    "axios": "1.7.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.2",
    "jest": "29.7.0",
    "tsup": "8.1.0",
    "typescript": "5.4.5"
  }
}
